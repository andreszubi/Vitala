// Copy this file to Secrets.xcconfig (same folder) and fill in your keys.
// Secrets.xcconfig is ignored by Git.

USDA_API_KEY = paste-your-usda-key-here

// From GoogleService-Info.plist (Firebase console > Project settings > your iOS app):
// API_KEY and CLIENT_ID.
FIREBASE_API_KEY = paste-your-firebase-api-key-here
GOOGLE_CLIENT_ID = paste-your-google-client-id-here
